# 借还本 MVP — 环境变量
# 复制为 .env.local 并填入实际值，勿提交 Git

DATABASE_URL="file:./prisma/dev.db"

# 会话签名密钥，至少 16 位随机字符串（生产环境务必更换）
AUTH_SECRET="change-me-to-a-long-random-secret"

# 会话 Cookie 是否仅 HTTPS 发送（可选）
# - 未设置：开发环境 false；生产环境按 X-Forwarded-Proto 判断，无该头则为 false
# - 使用 http://IP 访问生产时务必设为 false，否则刷新后 Cookie 会消失
# COOKIE_SECURE=false

# 应用访问子路径（唯一配置入口；根路径部署设为空字符串 BASE_PATH=）
BASE_PATH=/jiehuanben
